#!/usr/bin/env bash
# team-dash [project-dir] — open THE live team dashboard.
# No dialog: with a directory argument it re-points the running dashboard
# (or starts one for that project); without arguments it picks the freshest
# recently-active run. Switching between projects happens in the dashboard
# UI (Sessions & instances panel, View buttons) — the CLI never asks
# questions and never touches the running sessions themselves.
set -u
DB="$HOME/.local/share/opencode/opencode.db"

if [ $# -ge 1 ]; then
  DIR="$1"
else
  DIR="$(python3 - "$DB" << 'PYEOF'
import os, sqlite3, sys, time
d = ""
try:
    con = sqlite3.connect(f"file:{sys.argv[1]}?mode=ro", uri=True)
    rows = con.execute(
        "SELECT directory FROM session "
        "WHERE time_updated >= ? AND directory IS NOT NULL "
        "ORDER BY time_updated DESC LIMIT 8",
        (time.time() * 1000 - 12 * 3600 * 1000,),
    ).fetchall()
    d = next((r[0] for r in rows if r[0] and os.path.isdir(r[0])), "")
except Exception:
    d = ""
print(d)
PYEOF
)"
  [ -n "$DIR" ] && echo "team-dash: freshest run -> $DIR" >&2
fi

[ -n "$DIR" ] || { echo "team-dash: no recently-active runs (12h horizon)" >&2; exit 1; }
DIR="$(cd "$DIR" 2>/dev/null && pwd)" || { echo "team-dash: no such dir: $DIR" >&2; exit 1; }

for s in "$DIR/.opencode/scripts/team-dashboard.sh" "$HOME/.config/opencode/scripts/team-dashboard.sh"; do
  if [ -f "$s" ]; then
    exec bash "$s" serve "$DIR"
  fi
done
echo "team-dash: team-dashboard.sh not found (project-local or global install)" >&2
exit 1
