{
  "$schema": "https://opencode.ai/config.json",
  "plugin": ["context-mode", "@dietrichgebert/ponytail"],
  "permission": {
    "edit": { "*": "allow" },
    "bash": { "*": "allow" },
    "external_directory": {
      "*": "deny",
      "~/go/pkg/mod/**": "allow",
      "~/go/bin/**": "allow",
      "~/Library/Caches/go-build/**": "allow",
      "~/.cache/go-build/**": "allow",
      "~/.npm/**": "allow",
      "~/.cargo/**": "allow",
      "~/.rustup/**": "allow",
      "~/.cache/pip/**": "allow"
    }
  },
  "agent": {
    "coder": { "model": "zhipuai-coding-plan/glm-5.3" },
    "reviewer": {
      "model": "zhipuai-coding-plan/glm-5.3",
      "permission": {
        "bash": {
          "*": "deny",
          "git diff*": "allow",
          "git log*": "allow",
          "git show*": "allow",
          "git status*": "allow",
          "ls": "allow",
          "ls *": "allow",
          "cat *": "allow",
          "rg *": "allow",
          "go test ./...": "allow",
          "go vet ./...": "allow",
          "go build ./...": "allow",
          "*;*": "deny",
          "*&&*": "deny",
          "*|*": "deny",
          "*`*": "deny",
          "*$(*": "deny",
          "*>*": "deny",
          "*\n*": "deny"
        }
      }
    },
    "planner": { "model": "zhipuai-coding-plan/glm-5.3-flash" },
    "tester": { "model": "zhipuai-coding-plan/glm-5.3-flash" }
  }
}
