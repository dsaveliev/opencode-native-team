{
  "$schema": "https://opencode.ai/config.json",
  "permission": {
    "edit": { "*": "allow" },
    "bash": { "*": "allow" }
  },
  "agent": {
    "coder": { "model": "zhipuai-coding-plan/glm-5.3" },
    "reviewer": {
      "model": "zhipuai-coding-plan/glm-5.3",
      "permission": {
        "bash": {
          "*": "deny",
          "git diff*": "allow",
          "git log*": "allow",
          "git show*": "allow",
          "git status*": "allow",
          "ls": "allow",
          "ls *": "allow",
          "cat *": "allow",
          "rg *": "allow",
          "go test ./...": "allow",
          "go vet ./...": "allow",
          "go build ./...": "allow",
          "*;*": "deny",
          "*&&*": "deny",
          "*|*": "deny",
          "*`*": "deny",
          "*$(*": "deny",
          "*>*": "deny",
          "*\n*": "deny"
        }
      }
    },
    "planner": { "model": "zhipuai-coding-plan/glm-5.3-flash" },
    "tester": { "model": "zhipuai-coding-plan/glm-5.3-flash" }
  }
}
